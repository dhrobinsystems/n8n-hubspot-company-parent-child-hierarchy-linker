# -----------------------------------------------------------------------------
# n8n-hubspot-company-parent-child-hierarchy-linker - environment template
# Copy to .env (never commit it) or set these as n8n environment variables.
# Every value below is a placeholder or a safe default.
# -----------------------------------------------------------------------------

# --- n8n runtime requirements -------------------------------------------------
# Code nodes read configuration through $env and need the built-in crypto module.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
NODE_FUNCTION_ALLOW_BUILTIN=crypto

# --- HubSpot credentials (secrets) --------------------------------------------
# Private app access token with crm.objects.companies.read + crm.objects.companies.write.
HUBSPOT_PRIVATE_APP_TOKEN=REPLACE_WITH_HUBSPOT_PRIVATE_APP_TOKEN
# Client secret of the app that owns the webhook subscription (used for X-HubSpot-Signature-v3).
HUBSPOT_APP_CLIENT_SECRET=REPLACE_WITH_HUBSPOT_APP_CLIENT_SECRET

# --- HubSpot identity and allowlisting ----------------------------------------
# App ID of the integration that writes back to HubSpot. Events it caused are dropped (loop prevention).
HUBSPOT_APP_ID=REPLACE_WITH_HUBSPOT_APP_ID
# Only events from this portal are processed. Unset = every event is rejected (fail closed).
EXPECTED_PORTAL_ID=REPLACE_WITH_HUBSPOT_PORTAL_ID
# Portal ID of your HubSpot sandbox / developer test portal. Live writes with SANDBOX_MODE=true go only here.
HUBSPOT_SANDBOX_PORTAL_ID=REPLACE_WITH_HUBSPOT_SANDBOX_PORTAL_ID
HUBSPOT_API_BASE_URL=https://api.hubapi.com

# --- Webhook ------------------------------------------------------------------
# Public URL HubSpot calls. Must match exactly what HubSpot signs (set it when n8n is behind a proxy).
WEBHOOK_PUBLIC_URL=https://your-n8n-webhook-domain.com/webhook/hubspot-company-hierarchy
# Target for `npm run send:test-webhook` (usually the same URL, or the /webhook-test/ variant).
N8N_WEBHOOK_URL=https://your-n8n-webhook-domain.com/webhook/hubspot-company-hierarchy
# Replay window for X-HubSpot-Request-Timestamp, in milliseconds (HubSpot recommends 5 minutes).
SIGNATURE_MAX_AGE_MS=300000
# Comma-separated company properties whose changes trigger a run.
WATCHED_PROPERTIES=domain,website,parent_company_domain,duns_number,annualrevenue,hs_parent_company_id
MAX_EVENTS_PER_BATCH=100

# --- Safety controls ----------------------------------------------------------
# DRY_RUN=true computes and audits every decision but writes nothing to HubSpot.
DRY_RUN=true
# SANDBOX_MODE=true allows live writes only when the event portal equals HUBSPOT_SANDBOX_PORTAL_ID.
SANDBOX_MODE=true
# Maximum number of levels below the ultimate parent.
MAX_HIERARCHY_DEPTH=5
# Families larger than this are not rolled up (rollup is skipped and audited as FAMILY_TRUNCATED).
MAX_FAMILY_SIZE=500
# Retries for HubSpot 429 / 5xx responses (honours Retry-After).
HUBSPOT_MAX_RETRIES=3

# --- Matching -----------------------------------------------------------------
# HubSpot-defined company association type IDs: 14 = child -> parent, 13 = parent -> child.
HUBSPOT_ASSOC_TYPE_PRIMARY_PARENT=14
HUBSPOT_ASSOC_TYPE_CHILD=13
ENABLE_SUBDOMAIN_MATCHING=true
ENABLE_REGIONAL_MATCHING=true
# A regional entity (example.co.uk) is matched to brand.<tld> for each TLD listed here.
REGIONAL_PARENT_TLDS=com
# Comma-separated additions to the built-in exclusion lists.
EXTRA_FREE_MAIL_DOMAINS=
EXTRA_PARKED_DOMAINS=

# --- Rollups ------------------------------------------------------------------
ROLLUP_ENABLED=true

# --- Audit, review and alerting (leave empty to disable) ----------------------
# Example: https://your-n8n-webhook-domain.com/webhook/hierarchy-audit
AUDIT_LOG_WEBHOOK_URL=
# Example: https://your-n8n-webhook-domain.com/webhook/hierarchy-review
REVIEW_QUEUE_WEBHOOK_URL=
# Falls back to AUDIT_LOG_WEBHOOK_URL when empty.
ERROR_ALERT_WEBHOOK_URL=
